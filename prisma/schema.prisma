generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================== ENUMS ==================
enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  LEADERSHIP
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ================== USER MODEL ==================
model User {
  id          String @id @default(dbgenerated("gen_random_uuid()"))
  name        String @db.VarChar(80)
  email       String @unique
  role        Role   @default(MANAGER)
  password    String
  empId       String @unique


  isEnabled Boolean @default(true)
  isDeleted Boolean @default(false)

  mobileNumber String @unique

  addedBy   User?   @relation("UserAddedBy", fields: [addedById], references: [id])
  addedById String?

  addedUsers User[] @relation("UserAddedBy")

  createdProjects Project[] @relation("ProjectCreator")

  // project membership
  assignedProjects ProjectMember[] @relation("AssignedTo")

  assignedUsers ProjectMember[] @relation("AssignedBy")

  removedProjectMembers ProjectMember[] @relation("RemovedBy")

  uploadedDocuments Document[] @relation("DocumentUploadedBy")

  projectRemarks ProjectRemark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// ================== PROJECT MODEL ==================
model Project {
  id          String          @id @default(dbgenerated("gen_random_uuid()"))
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  clientName  String?
  startDate   DateTime?
  endDate     DateTime?
  devUrl      String?
  uatUrl      String?
  prodUrl     String?
  isSetupCompleted Boolean @default(false) 

  isEnabled Boolean @default(true)
  isDeleted Boolean @default(false)

  // Relations
  createdBy   User   @relation("ProjectCreator", fields: [createdById], references: [id])
  createdById String

  // members
  members ProjectMember[]

  documents Document[]

  developers String[]

  remarks ProjectRemark[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("projects")
}

//===================Project MEMBER=============================
model ProjectMember {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  projectId String

  assignedToId String

  assignedById String

  assignedAt DateTime @default(now())

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  removedById String?

  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  //Relations

  project    Project @relation(fields: [projectId], references: [id])
  assignedTo User    @relation("AssignedTo", fields: [assignedToId], references: [id])
  assignedBy User    @relation("AssignedBy", fields: [assignedById], references: [id])
  removedBy  User?   @relation("RemovedBy", fields: [removedById], references: [id])

  @@unique([projectId, assignedToId])
  @@index([projectId])
  @@index([assignedToId])
  @@index([assignedById])
  @@index([removedById])
  @@map("project_members")
}

// ================== DOCUMENT MODEL ==================
model Document {
  id       String  @id @default(dbgenerated("gen_random_uuid()"))
  name     String
  url      String
  fileType String?
  fileSize String?

  // Relations
  project   Project @relation(fields: [projectId], references: [id])
  projectId String

  uploadedBy   User?   @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  uploadedById String?

  isEnabled Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("documents")
}

//*******************************PROJECT REMARKS*************************************

model ProjectRemark {
  id String @id @default(dbgenerated("gen_random_uuid()"))

  projectId String

  remark String 

  addedById String

  isDeleted Boolean @default(false)

  isEnabled Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  //Relations

  project Project @relation(fields: [projectId], references: [id])

  addedBy User @relation(fields: [addedById], references: [id])

  @@index([projectId])
  @@index([addedById])
  @@index([createdAt])
  @@map("project_remarks")
}
